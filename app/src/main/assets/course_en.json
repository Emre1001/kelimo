{"target":"en","version":1,"units":[{"id":"e1","cefr":"A1","icon":"chat","title":{"tr":"Tanışma","en":"Meeting people","de":"Kennenlernen"},"grammar":[{"id":"e_be","title":{"tr":"\"to be\": am, is, are","en":"\"to be\": am, is, are","de":"„to be“: am, is, are"},"body":{"tr":"Türkçedeki \"-im, -sin, -dir\" ekleri İngilizcede \"am / is / are\" ile yapılır: I am, you are, he/she/it is, we/they are.","en":"I am, you are, he/she/it is, we/they are.","de":"I am, you are, he/she/it is, we/they are."},"examples":[{"t":"I am a student.","tr":"Ben öğrenciyim.","de":"Ich bin Student."}],"keys":["be","am","is","are","olmak"]},{"id":"e_article","title":{"tr":"a / an","en":"a / an","de":"a / an"},"body":{"tr":"Tekil sayılabilir isimlerden önce \"a\" ya da sesli harften önce \"an\" gelir: a book, an apple. Meslekte de kullanılır: \"I am a teacher.\"","en":"Use a/an before singular countable nouns, also for jobs: \"I am a teacher.\"","de":"a/an vor Nomen im Singular, auch bei Berufen."},"examples":[{"t":"She is an engineer.","tr":"O bir mühendis.","de":"Sie ist Ingenieurin."}],"keys":["a","an","article","artikel"]}],"lessons":[{"id":"e1l1","title":{"tr":"Merhaba","en":"Hello","de":"Hallo"},"words":[{"t":"hello","tr":"merhaba","de":"hallo"},{"t":"name","tr":"isim","de":"Name"},{"t":"friend","tr":"arkadaş","de":"Freund"},{"t":"student","tr":"öğrenci","de":"Student"},{"t":"teacher","tr":"öğretmen","de":"Lehrer"},{"t":"thank you","tr":"teşekkürler","de":"danke"},{"t":"please","tr":"lütfen","de":"bitte"},{"t":"goodbye","tr":"hoşça kal","de":"auf Wiedersehen"}],"sentences":[{"t":"Hello, my name is Ayşe.","tr":"Merhaba, benim adım Ayşe.","de":"Hallo, ich heiße Ayşe."},{"t":"What is your name?","tr":"Adın ne?","de":"Wie heißt du?"},{"t":"I am a student.","tr":"Ben öğrenciyim.","de":"Ich bin Student."},{"t":"This is my friend.","tr":"Bu benim arkadaşım.","de":"Das ist mein Freund."},{"t":"Nice to meet you.","tr":"Tanıştığımıza memnun oldum.","de":"Freut mich."}]},{"id":"e1l2","title":{"tr":