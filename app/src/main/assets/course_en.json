 annem.","de":"Das ist meine Mutter."},{"t":"I have a brother and a sister.","tr":"Bir erkek ve bir kız kardeşim var.","de":"Ich habe einen Bruder und eine Schwester."},{"t":"My father works in a bank.","tr":"Babam bir bankada çalışıyor.","de":"Mein Vater arbeitet in einer Bank."},{"t":"We have two children.","tr":"İki çocuğumuz var.","de":"Wir haben zwei Kinder."},{"t":"My family is very big.","tr":"Ailem çok büyük.","de":"Meine Familie ist sehr groß."}]},{"id":"e2l2","title":{"tr":"Evim","en":"My home","de":"Mein Zuhause"},"words":[{"t":"house","tr":"ev","de":"Haus"},{"t":"kitchen","tr":"mutfak","de":"Küche"},{"t":"room","tr":"oda","de":"Zimmer"},{"t":"bed","tr":"yatak","de":"Bett"},{"t":"table","tr":"masa","de":"Tisch"},{"t":"window","tr":"pencere","de":"Fenster"},{"t":"small","tr":"küçük","de":"klein"},{"t":"big","tr":"büyük","de":"groß"}],"sentences":[{"t":"My house is small.","tr":"Evim küçük.","de":"Mein Haus ist klein."},{"t":"The kitchen is big.","tr":"Mutfak büyük.","de":"Die Küche ist groß."},{"t":"There is a table in the room.","tr":"Odada bir masa var.","de":"Im Zimmer ist ein Tisch."},{"t":"Please open the window.","tr":"Lütfen pencereyi aç.","de":"Bitte mach das Fenster auf."},{"t":"My bed is very comfortable.","tr":"Yatağım çok rahat.","de":"Mein Bett ist sehr bequem."}]}]},{"id":"e3","cefr":"A1","icon":"day","title":{"tr":"Gündelik hayat","en":"Daily routine","de":"Alltag"},"grammar":[{"id":"e_present","title":{"tr":"Geniş zaman ve -s","en":"Present simple and -s","de":"Present Simple und -s"},"body":{"tr":"Alışkanlıklar için geniş zaman kullanılır. he/she/it ile fiile -s eklenir: \"She works.\" Soru ve olumsuzda do/does: \"Do you work?\", \"He doesn't work.\"","en":"Habits use the present simple; he/she/it adds -s. Questions/negatives use do/does.","de":"he/she/it + -s; Fragen mit do/does."},"examples":[{"t":"He gets up at seven.","tr":"Yedide kalkar.","de":"Er steht um sieben auf."}],"keys":["present","simple","-s","does","geniş zaman"]}],"lessons":[{"id":"e3l1","title":{"tr":"Günüm","en":"My day","de":"Mein Tag"},"words":[{"t":"get up","tr":"kalkmak","de":"aufstehen"},{"t":"breakfast","tr":"kahvaltı","de":"Frühstück"},{"t":"work","tr":"çalışmak / iş","de":"arbeiten"},{"t":"eat","tr":"yemek","de":"essen"},{"t":"drink","tr":"içmek","de":"trinken"},{"t":"sleep","tr":"uyumak","de":"schlafen"},{"t":"morning","tr":"sabah","de":"Morgen"},{"t":"evening","tr":"akşam","de":"Abend"}],"sentences":[{"t":"I get up at seven.","tr":"Yedide kalkarım.","de":"Ich stehe um sieben auf."},{"t":"She drinks tea in the morning.","tr":"Sabahları çay içer.","de":"Sie trinkt morgens Tee.","alt":["In the morning she drinks tea."]},{"t":"We eat dinner in the evening.","tr":"Akşam yemeği akşam yeriz.","de":"Wir essen abends zu Abend."},{"t":"Do you work on Saturday?","tr":"Cumartesi çalışıyor musun?","de":"Arbeitest du am Samstag?"},{"t":"He doesn't drink coffee.","tr":"Kahve içmez.","de":"Er trinkt keinen Kaffee."}]},{"id":"e3l2","title":{"tr":"Alışveriş","en":"Shopping","de":"Einkaufen"},"words":[{"t":"shop","tr":"dükkan","de":"Laden"},{"t":"buy","tr":"satın almak","de":"kaufen"},{"t":"price","tr":"fiyat","de":"Preis"},{"t":"cheap","tr":"ucuz","de":"billig"},{"t":"expensive","tr":"pahalı","de":"teuer"},{"t":"money","tr":"para","de":"Geld"},{"t":"bread","tr":"ekmek","de":"Brot"},{"t":"water","tr":"su","de":"Wasser"}],"sentences":[{"t":"How much is this?","tr":"Bu ne kadar?","de":"Wie viel kostet das?"},{"t":"That is too expensive.","tr":"Bu çok pahalı.","de":"Das ist zu teuer."},{"t":"I want to buy bread.","tr":"Ekmek almak istiyorum.","de":"Ich möchte Brot kaufen."},{"t":"Can I pay by card?","tr":"Kartla ödeyebilir miyim?","de":"Kann ich mit Karte zahlen?"},{"t":"A bottle of water, please.","tr":"Bir şişe su, lütfen.","de":"Eine Flasche Wasser, bitte."}]}]},{"id":"e4","cefr":"A2","icon":"travel","title":{"tr":"Seyahat ve geçmiş","en":"Travel and the past","de":"Reisen und Vergangenheit"},"grammar":[{"id":"e_past","title":{"tr":"Geçmiş 